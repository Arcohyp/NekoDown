{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoDown",
  "version": "0.1.0",
  "identifier": "top.nekogal.nekodown",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NekoDown",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../lib": "lib",
      "../../lang.json": "lang.json",
      "../../config.json": "config.json",
      "../../neko-down.ps1": "neko-down.ps1",
      "../../双击运行.cmd": "双击运行.cmd",
      "../../README.md": "README.md",
      "../../LICENSE": "LICENSE"
    }
  }
}

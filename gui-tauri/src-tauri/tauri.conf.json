{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoDown",
  "version": "3.3.3",
  "identifier": "top.nekogal.nekodown",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NekoDown",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://github.com https://api.github.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Arcohyp/NekoDown/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../lib": "lib",
      "../../lang.json": "lang.json",
      "../../neko-down.ps1": "neko-down.ps1",
      "../../双击运行.cmd": "双击运行.cmd",
      "../../README.md": "README.md",
      "../../LICENSE": "LICENSE"
    }
  }
}
